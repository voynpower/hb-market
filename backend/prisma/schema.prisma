generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model addresses {
  id              BigInt   @id @default(autoincrement())
  user_id         BigInt
  recipient_name  String   @db.VarChar(100)
  recipient_phone String   @db.VarChar(30)
  zip_code        String   @db.VarChar(20)
  address1        String   @db.VarChar(255)
  address2        String?  @db.VarChar(255)
  is_default      Boolean  @default(false)
  created_at      DateTime @default(now()) @db.DateTime(0)
  updated_at      DateTime @default(now()) @db.DateTime(0)
  users           users    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_addresses_user")
  orders          orders[]

  @@index([user_id], map: "fk_addresses_user")
}

model cart_items {
  id                BigInt           @id @default(autoincrement())
  cart_id           BigInt
  product_id        BigInt
  product_option_id BigInt?
  quantity          Int              @default(1)
  unit_price        Decimal          @db.Decimal(12, 2)
  created_at        DateTime         @default(now()) @db.DateTime(0)
  updated_at        DateTime         @default(now()) @db.DateTime(0)
  carts             carts            @relation(fields: [cart_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cart_items_cart")
  products          products         @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cart_items_product")
  product_options   product_options? @relation(fields: [product_option_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cart_items_product_option")

  @@index([cart_id], map: "fk_cart_items_cart")
  @@index([product_id], map: "fk_cart_items_product")
  @@index([product_option_id], map: "fk_cart_items_product_option")
}

model carts {
  id         BigInt       @id @default(autoincrement())
  user_id    BigInt       @unique(map: "user_id")
  created_at DateTime     @default(now()) @db.DateTime(0)
  updated_at DateTime     @default(now()) @db.DateTime(0)
  cart_items cart_items[]
  users      users        @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_carts_user")
}

model order_items {
  id                BigInt           @id @default(autoincrement())
  order_id          BigInt
  product_id        BigInt
  product_option_id BigInt?
  product_name      String           @db.VarChar(200)
  option_name       String?          @db.VarChar(100)
  option_value      String?          @db.VarChar(100)
  quantity          Int
  unit_price        Decimal          @db.Decimal(12, 2)
  total_price       Decimal          @db.Decimal(12, 2)
  created_at        DateTime         @default(now()) @db.DateTime(0)
  orders            orders           @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_order_items_order")
  products          products         @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_order_items_product")
  product_options   product_options? @relation(fields: [product_option_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_order_items_product_option")

  @@index([order_id], map: "fk_order_items_order")
  @@index([product_id], map: "fk_order_items_product")
  @@index([product_option_id], map: "fk_order_items_product_option")
}

model orders {
  id              BigInt        @id @default(autoincrement())
  user_id         BigInt
  address_id      BigInt
  order_number    String        @unique(map: "order_number") @db.VarChar(50)
  order_status    String        @default("CREATED") @db.VarChar(30)
  payment_status  String        @default("PENDING") @db.VarChar(30)
  delivery_status String        @default("READY") @db.VarChar(30)
  total_amount    Decimal       @db.Decimal(12, 2)
  created_at      DateTime      @default(now()) @db.DateTime(0)
  updated_at      DateTime      @default(now()) @db.DateTime(0)
  order_items     order_items[]
  addresses       addresses     @relation(fields: [address_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_orders_address")
  users           users         @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_orders_user")
  payments        payments?
  shipments       shipments?

  @@index([address_id], map: "fk_orders_address")
  @@index([user_id], map: "fk_orders_user")
}

model payments {
  id              BigInt    @id @default(autoincrement())
  order_id        BigInt    @unique(map: "order_id")
  payment_method  String    @db.VarChar(30)
  payment_status  String    @default("PENDING") @db.VarChar(30)
  amount          Decimal   @db.Decimal(12, 2)
  transaction_key String?   @db.VarChar(100)
  paid_at         DateTime? @db.DateTime(0)
  created_at      DateTime  @default(now()) @db.DateTime(0)
  updated_at      DateTime  @default(now()) @db.DateTime(0)
  orders          orders    @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_payments_order")
}

model product_options {
  id           BigInt        @id @default(autoincrement())
  product_id   BigInt
  option_name  String        @db.VarChar(100)
  option_value String        @db.VarChar(100)
  extra_price  Decimal       @default(0.00) @db.Decimal(12, 2)
  stock_qty    Int           @default(0)
  sku          String?       @unique(map: "sku") @db.VarChar(100)
  created_at   DateTime      @default(now()) @db.DateTime(0)
  updated_at   DateTime      @default(now()) @db.DateTime(0)
  cart_items   cart_items[]
  order_items  order_items[]
  products     products      @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_product_options_product")

  @@index([product_id], map: "fk_product_options_product")
}

model products {
  id              BigInt            @id @default(autoincrement())
  name            String            @db.VarChar(200)
  description     String?           @db.Text
  base_price      Decimal           @db.Decimal(12, 2)
  status          String            @default("ON_SALE") @db.VarChar(20)
  created_at      DateTime          @default(now()) @db.DateTime(0)
  updated_at      DateTime          @default(now()) @db.DateTime(0)
  cart_items      cart_items[]
  order_items     order_items[]
  product_images  product_images[]
  product_options product_options[]
}

model shipments {
  id              BigInt    @id @default(autoincrement())
  order_id        BigInt    @unique(map: "order_id")
  courier         String?   @db.VarChar(100)
  tracking_number String?   @db.VarChar(100)
  shipment_status String    @default("READY") @db.VarChar(30)
  shipped_at      DateTime? @db.DateTime(0)
  delivered_at    DateTime? @db.DateTime(0)
  created_at      DateTime  @default(now()) @db.DateTime(0)
  updated_at      DateTime  @default(now()) @db.DateTime(0)
  orders          orders    @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_shipments_order")
}

model users {
  id            BigInt      @id @default(autoincrement())
  email         String      @unique(map: "email") @db.VarChar(255)
  password_hash String      @db.VarChar(255)
  name          String      @db.VarChar(100)
  phone         String?     @db.VarChar(30)
  role          String      @default("USER") @db.VarChar(20)
  status        String      @default("ACTIVE") @db.VarChar(20)
  created_at    DateTime    @default(now()) @db.DateTime(0)
  updated_at    DateTime    @default(now()) @db.DateTime(0)
  addresses     addresses[]
  carts         carts?
  orders        orders[]
}

model admin_users {
  id            BigInt    @id @default(autoincrement())
  email         String    @unique(map: "uk_admin_users_email") @db.VarChar(255)
  password_hash String    @db.VarChar(255)
  name          String    @db.VarChar(100)
  role          String    @default("ADMIN") @db.VarChar(20)
  status        String    @default("ACTIVE") @db.VarChar(20)
  last_login_at DateTime? @db.DateTime(0)
  created_at    DateTime  @default(now()) @db.DateTime(0)
  updated_at    DateTime  @default(now()) @db.DateTime(0)
}

model product_images {
  id         BigInt   @id @default(autoincrement())
  product_id BigInt
  url        String   @db.VarChar(500)
  alt        String?  @db.VarChar(255)
  is_primary Boolean  @default(false)
  sort_order Int      @default(0)
  created_at DateTime @default(now()) @db.DateTime(0)
  updated_at DateTime @default(now()) @db.DateTime(0)
  products   products @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_product_images_product")

  @@index([product_id], map: "idx_product_images_product_id")
}
